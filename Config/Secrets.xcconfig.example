// Copy to Config/Secrets.xcconfig and fill in. Host only — no "https://".
SUPABASE_HOST = your-project-ref.supabase.co
SUPABASE_ANON_KEY = your-anon-or-publishable-key
SPOTIFY_CLIENT_ID = your-spotify-client-id
// Google iOS OAuth client: GOOGLE_REVERSED_CLIENT_ID is the client ID with ".apps.googleusercontent.com"
// removed and "com.googleusercontent.apps." put in front.
GOOGLE_CLIENT_ID = 1234567890-abcdef.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.1234567890-abcdef
